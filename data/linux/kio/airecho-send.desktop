# Dolphin (KDE): right-click files → "Send with AirEcho".
# dev-install.sh copies this to ~/.local/share/kio/servicemenus/ (executable, as KDE
# requires) with @AIRECHO_BIN@ replaced.
[Desktop Entry]
Type=Service
MimeType=all/allfiles;inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
Actions=sendWithAirEcho

[Desktop Action sendWithAirEcho]
Name=Send with AirEcho
Icon=document-send
Exec=@AIRECHO_BIN@ %F
