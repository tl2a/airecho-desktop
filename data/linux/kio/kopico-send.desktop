# Dolphin (KDE): right-click files → "Send with Kopico".
# dev-install.sh copies this to ~/.local/share/kio/servicemenus/ (executable, as KDE
# requires) with @KOPICO_BIN@ replaced.
[Desktop Entry]
Type=Service
MimeType=all/allfiles;inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
Actions=sendWithKopico

[Desktop Action sendWithKopico]
Name=Send with Kopico
Icon=document-send
Exec=@KOPICO_BIN@ %F
