using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: _("AirEcho");
  default-width: 640;
  default-height: 560;
  width-request: 360;
  height-request: 294;

  // Narrow windows: move the tabs from the header bar to a bottom bar (GNOME HIG)
  Adw.Breakpoint {
    condition ("max-width: 550sp")

    setters {
      switcher_bar.reveal: true;
      view_switcher.visible: false;
    }
  }

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      title-widget: Adw.ViewSwitcher view_switcher {
        stack: view_stack;
        policy: wide;
      };

      [end]
      Gtk.MenuButton main_menu_button {
        icon-name: "view-more-symbolic";
        tooltip-text: _("Main Menu");
        accessible-role: button;
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      Adw.ViewStack view_stack {
        // ── Home: big power toggle ───────────────────────────────────────────
        Adw.ViewStackPage {
          name: "home";
          title: _("Home");
          icon-name: "go-home-symbolic";

          child: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            Adw.Clamp {
              maximum-size: 400;
              valign: center;
              margin-top: 36;
              margin-bottom: 36;
              margin-start: 12;
              margin-end: 12;

              Gtk.Box {
                orientation: vertical;
                spacing: 24;

                // Actionable: the button's active state *is* the app.enabled state,
                // so it stays in sync with the tray "Enable" checkbox automatically.
                Gtk.ToggleButton power_toggle {
                  action-name: "app.enabled";
                  halign: center;
                  tooltip-text: _("Turn AirEcho On or Off");

                  styles [
                    "circular",
                    "power-toggle",
                  ]

                  Gtk.Image {
                    icon-name: "system-shutdown-symbolic";
                    pixel-size: 64;
                    accessible-role: presentation;
                  }

                  accessibility {
                    label: _("AirEcho");
                  }
                }

                Gtk.Box {
                  orientation: vertical;
                  spacing: 6;
                  height-request: 112;

                  Gtk.Label state_title {
                    label: _("AirEcho Is On");
                    wrap: true;
                    justify: center;

                    styles [
                      "title-1",
                    ]
                  }

                  Gtk.Label state_description {
                    label: _("AirEcho is running. Turn it off at any time from here or from the system tray.");
                    wrap: true;
                    justify: center;

                    styles [
                      "dim-label",
                    ]
                  }
                }
              }
            }
          };
        }

        // ── Advanced settings ───────────────────────────────────────────────
        Adw.ViewStackPage {
          name: "advanced";
          title: _("Advanced");
          icon-name: "emblem-system-symbolic";

          child: Adw.PreferencesPage {
            title: _("Advanced");

            Adw.PreferencesGroup {
              title: _("Receive");
              description: _("AirEcho polls croc in the background and receives files automatically.");

              // Subtitle is set from Rust to describe the selected mode
              Adw.ComboRow relay_mode_row {
                title: _("Relay Mode");

                // Order must match RELAY_MODES in main.rs
                model: Gtk.StringList {
                  strings [
                    _("Local Network"),
                    _("Own Relay"),
                    _("Public Relay"),
                  ]
                };
              }

              // Only visible for "Local Network". Optional: leave empty to discover
              // the sender automatically; set it when discovery doesn't find it.
              Adw.EntryRow sender_ip_row {
                title: _("Sender IP Address (Optional)");
                tooltip-text: _("Enter the sender IP address (e.g. 192.168.1.20) if automatic discovery doesn't find it.");
                show-apply-button: true;
              }

              // Only visible for "Own Relay"
              Adw.EntryRow relay_address_row {
                title: _("Relay Address");
                show-apply-button: true;
                input-purpose: url;
              }

              Adw.PasswordEntryRow relay_password_row {
                title: _("Relay Password");
                show-apply-button: true;
              }

              Adw.EntryRow receive_code_row {
                title: _("Receive Code");
                show-apply-button: true;
              }

              Adw.ActionRow save_to_row {
                title: _("Save To");
                subtitle-selectable: true;

                styles [
                  "property",
                ]
              }
            }

            Adw.PreferencesGroup {
              title: _("Send");
              description: _("Sends use the same code and mode as receiving. Receiving pauses while sending.");

              Adw.SwitchRow send_clipboard_row {
                title: _("Send Copied Text");
                subtitle: _("Send text whenever you copy it. Copies marked private by password managers are skipped.");
                active: true;
              }

              Adw.ActionRow {
                title: _("Send Files…");
                subtitle: _("Or select files in Finder or Files and choose “Send with AirEcho”");
                activatable: true;
                action-name: "app.send-files";

                [suffix]
                Gtk.Image {
                  icon-name: "document-send-symbolic";
                  accessible-role: presentation;
                }
              }
            }

            Adw.PreferencesGroup {
              title: _("Background");

              Adw.SwitchRow tray_row {
                title: _("Show in System Tray");
                subtitle: _("Keep AirEcho running in the background when the window is closed");
                active: true;
              }
            }
          };
        }
      }
    };

    [bottom]
    Adw.ViewSwitcherBar switcher_bar {
      stack: view_stack;
    }
  };
}
